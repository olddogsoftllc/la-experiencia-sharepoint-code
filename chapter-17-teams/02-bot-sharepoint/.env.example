# Credenciales del bot (App Registration de Entra ID del bot)
MICROSOFT_APP_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_APP_PASSWORD=tu-client-secret-del-bot

# Credenciales de Graph (app-only, para leer SharePoint)
# App Registration SEPARADA o la misma, con permisos Sites.Read.All (o Sites.Selected)
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=tu-client-secret-de-graph

# Puerto del servidor (Teams Bot Framework llama a /api/messages)
PORT=3978