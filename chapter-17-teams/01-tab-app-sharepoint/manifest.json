{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "packageName": "com.contoso.sharepointtab",
  "developer": {
    "name": "Contoso",
    "websiteUrl": "https://www.contoso.com",
    "privacyUrl": "https://www.contoso.com/privacy",
    "termsOfUseUrl": "https://www.contoso.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "SP Projects",
    "full": "SharePoint Projects Tab for Teams"
  },
  "description": {
    "short": "Surfaces SharePoint project sites as a Teams tab",
    "full": "Embeds the SharePoint project hub as a personal tab in Microsoft Teams via teamslogon.aspx."
  },
  "accentColor": "#107c10",
  "staticTabs": [
    {
      "entityId": "projects",
      "name": "Projects",
      "contentUrl": "https://TENANT.sharepoint.com/sites/projects/_layouts/15/teamslogon.aspx?source=teams&entityId=projects",
      "websiteUrl": "https://TENANT.sharepoint.com/sites/projects",
      "scopes": ["personal"]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["TENANT.sharepoint.com", "token.botframework.com"]
}